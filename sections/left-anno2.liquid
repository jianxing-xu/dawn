<div class="left-anno">
  <h1>{{ section.settings.title }}</h1>
</div>
<style>
  .left-anno {
    width: 50%;
    line-height: 100px;
    background: {{ section.settings.background_color }};
    h1 {
      color: white;
    }
  }
</style>
{% schema %}
{
  "name": "Left Anno 2222",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "Hello World",
      "label": "Anno Text"
    },
    {
      "type": "text",
      "id": "background_color",
      "default": "#000",
      "label": "Background Color"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Left Anno 222",
      "settings": {
        "title": "Hello World",
        "background_color": "#000"
      }
    }
  ]
}
{% endschema %}
